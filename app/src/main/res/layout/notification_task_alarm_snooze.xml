<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">
    <TextView
        android:id="@+id/task_alarm_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Alarm czynności"
        android:textStyle="bold"
        android:textSize="14sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:paddingBottom="6dp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Odłóż alarm:"
        android:textSize="12sp"
        android:paddingBottom="2dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/task_snooze_5" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:minWidth="0dp" android:padding="0dp" android:text="5m" android:textSize="12sp" />
        <Button android:id="@+id/task_snooze_10" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:minWidth="0dp" android:padding="0dp" android:text="10m" android:textSize="12sp" />
        <Button android:id="@+id/task_snooze_15" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:minWidth="0dp" android:padding="0dp" android:text="15m" android:textSize="12sp" />
        <Button android:id="@+id/task_snooze_30" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:minWidth="0dp" android:padding="0dp" android:text="30m" android:textSize="12sp" />
        <Button android:id="@+id/task_snooze_60" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:minWidth="0dp" android:padding="0dp" android:text="60m" android:textSize="12sp" />
    </LinearLayout>
    <Button
        android:id="@+id/task_alarm_mute"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Wycisz alarm"
        android:textAllCaps="false" />
</LinearLayout>
